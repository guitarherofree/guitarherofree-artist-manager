# Build settings for Manager, read by Scripts/build.sh (which the GitHub workflows run).
# The version isn't here: releases take it from the top "## x.y.z" heading in CHANGELOG.md.

APP_NAME="Manager"
EXECUTABLE="Manager"
# The Swift package product that becomes the app.
BUILD_PRODUCT="ArtistManager"
BUNDLE_ID="com.freemanedwards.Manager"

# The in-app updater reads releases from this repository.
GITHUB_REPOSITORY="guitarherofree/guitarherofree-artist-manager"
